{
  "manifest_version": 3,
  "name": "ChatGPT DOM Trimmer",
  "version": "0.1.0",
  "description": "Collapses older ChatGPT messages to reduce DOM bloat and memory usage.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
